{
  "name": "local-media-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node tests/e2e/run.mjs",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "spike:fixtures": "node scripts/spike-fixtures.mjs",
    "spike:build": "node scripts/spike-build.mjs",
    "spike:small": "node spikes/001-browser-gates/run.mjs",
    "spike:auth": "node spikes/001-browser-gates/auth.mjs",
    "spike:remux": "node spikes/002-remux-browser/run.mjs",
    "spike:large": "LMD_LARGE=1 node spikes/001-browser-gates/run.mjs && node spikes/002-remux-browser/large.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "mediabunny": "1.65.1"
  }
}
